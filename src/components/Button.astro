---
interface Props {
	href?: string;
	variant?: 'claro';
	target?: string;
	rel?: string;
}

const { href, variant = 'claro', target, rel } = Astro.props;
const clase = `boton boton--${variant}`;
---

{
	href ? (
		<a class={clase} href={href} target={target} rel={rel}>
			<slot />
		</a>
	) : (
		<button class={clase} type="button">
			<slot />
		</button>
	)
}