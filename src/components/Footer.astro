---
import Emblem from './Emblem.astro';
import Divider from './Divider.astro';
import { seccionesFooter } from '../data/sacra-traditio';
---

<footer class="pie-pagina">
	<div class="contenedor">
		<div class="pie-pagina__superior">
			<div class="pie-pagina__marca">
				<Emblem variant="marca" />
			</div>
			<h2 class="pie-pagina__titulo">Jesús de la Merced</h2>
			<p class="pie-pagina__lema">Patrón Jurado de la Ciudad de Guatemala</p>
			<Divider />
		</div>

		<div class="pie-pagina__secciones">
			{seccionesFooter.map((seccion) => (
				<div class="pie-pagina__seccion">
					<h3 class="pie-pagina__encabezado">{seccion.titulo}</h3>
					<ul>
						{seccion.enlaces.map((enlace) => (
							<li>
								<a class="pie-pagina__enlace" href={enlace.destino}>{enlace.texto}</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="pie-pagina__inferior">
			<p>© {new Date().getFullYear()} Jesús de la Merced — Patrón Jurado de la Ciudad de Guatemala</p>
			<p>Página informativa elaborada en devoción a la imagen · no es un sitio oficial de la Asociación de Devotos</p>
		</div>
	</div>
</footer>