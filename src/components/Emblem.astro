---
interface Props {
	variant?: 'marca' | 'divisor';
}

const { variant = 'marca' } = Astro.props;
const clase = `emblema emblema--${variant}`;

const angulosRayos = Array.from({ length: 12 }, (_, indice) => indice * 30);
---

<span class={clase} aria-hidden="true">
	<svg class="emblema__sv" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
		<g stroke="var(--color-accent-gold)" stroke-width="1.5" opacity="0.45">
			{angulosRayos.map((angulo) => (
				<line x1="50" y1="5" x2="50" y2="10" transform={`rotate(${angulo} 50 50)`} />
			))}
		</g>
		<circle
			cx="50"
			cy="50"
			r="42"
			stroke="var(--color-accent-gold)"
			stroke-width="1.5"
			opacity="0.55"
		/>
		<circle
			cx="50"
			cy="50"
			r="36"
			stroke="var(--color-accent-gold)"
			stroke-width="1"
			opacity="0.28"
		/>
		<path
			d="M45 27 h10 v13 h17 v10 h-17 v20 h-10 v-20 h-17 v-10 h17 z"
			fill="var(--color-accent-gold)"
		/>
	</svg>
</span>